# C64 modern-retro Ghostty config. Launch: ghostty --config-file=~/Projects/omarchy-c64/ghostty/config
font-family = "Space Mono"
font-size = 11
adjust-cell-height = 12%

window-padding-x = 14
window-padding-y = 14
window-theme = ghostty
confirm-close-surface = false
resize-overlay = never
cursor-style = block
cursor-style-blink = false

background = 2d2475
foreground = fbf9ff
cursor-color = ffd400
cursor-text = 2d2475
selection-background = 4a3c9a
selection-foreground = ffffff

palette = 0=#2d2475
palette = 1=#e8402f
palette = 2=#55b84a
palette = 3=#ffd400
palette = 4=#9a8df0
palette = 5=#c46fc4
palette = 6=#4fc9e8
palette = 7=#f4f1ff
palette = 8=#a9a0e6
palette = 9=#ff6a5a
palette = 10=#7fdc72
palette = 11=#ffe666
palette = 12=#bdb4ff
palette = 13=#e69be6
palette = 14=#8ae4ff
palette = 15=#ffffff

custom-shader = crt.glsl
